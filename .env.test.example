# Used only by the automated test suite (see vitest-setup/global-setup.ts).
# Points at the throwaway local Postgres container from docker-compose.yml
# (`docker compose up -d test-db` — global-setup does this automatically),
# not at the hosted Supabase project dev uses. Copy this file to .env.test
# as-is; there's no real secret in it, since the container is local-only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres"
SESSION_SECRET="test-only-secret"
