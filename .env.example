# Local dev: SQLite file. For hosted Postgres (e.g. Supabase), set this to
# the Postgres connection string and change `provider` in prisma/schema.prisma
# to "postgresql" — application code does not need to change.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign the "auth_session" cookie for signed-in users (HMAC).
# Generate a real value for any non-local environment, e.g.:
#   openssl rand -base64 32
SESSION_SECRET="dev-only-insecure-secret-change-me"
