# Hosted Postgres connection string (e.g. from a Supabase project's
# Settings > Database > Connection string). Percent-encode any special
# characters in the password (e.g. "@" -> "%40"), since an unescaped one
# breaks URL parsing.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# OAuth client ID from Google Cloud Console (APIs & Services > Credentials).
# Public by design — it's embedded in the login page's HTML either way.
# Leave unset to fall back to the dev-only stub sign-in form at /login.
PUBLIC_GOOGLE_CLIENT_ID=""

# Secret used to sign the "auth_session" cookie for signed-in users (HMAC).
# Generate a real value for any non-local environment, e.g.:
#   openssl rand -base64 32
SESSION_SECRET="dev-only-insecure-secret-change-me"
